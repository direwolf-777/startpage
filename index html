<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Personal Hub - Glassmorphism Startpage</title>
  <style>
    :root {
      --bg-gradient: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #0f172a 100%);
      --card-bg: rgba(30, 41, 59, 0.6);
      --card-border: rgba(255, 255, 255, 0.08);
      --card-hover-bg: rgba(51, 65, 85, 0.7);
      --accent: #818cf8;
      --accent-glow: rgba(129, 140, 248, 0.25);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --danger: #f43f5e;
      --success: #34d399;
      --radius-lg: 16px;
      --radius-md: 10px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg-gradient);
      background-attachment: fixed;
      color: var(--text-main);
      min-height: 100vh;
      padding: 2rem 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    header {
      width: 100%;
      max-width: 1280px;
      margin-bottom: 2rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .clock-container {
      display: flex;
      flex-direction: column;
    }

    .time {
      font-size: 2.5rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--text-main);
      text-shadow: 0 0 20px rgba(255, 255, 255, 0.1);
    }

    .date {
      font-size: 0.95rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    .controls {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .btn {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      color: var(--text-main);
      padding: 0.6rem 1rem;
      border-radius: var(--radius-md);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      backdrop-filter: blur(12px);
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn:hover {
      background: var(--card-hover-bg);
      border-color: rgba(255, 255, 255, 0.2);
      transform: translateY(-1px);
    }

    .btn-danger {
      color: var(--danger);
    }

    .btn-danger:hover {
      background: rgba(244, 63, 94, 0.15);
      border-color: var(--danger);
    }

    #file-input {
      display: none;
    }

    .search-container {
      position: relative;
      width: 100%;
    }

    .search-input {
      width: 100%;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      padding: 1rem 1.25rem;
      border-radius: var(--radius-lg);
      color: var(--text-main);
      font-size: 1rem;
      backdrop-filter: blur(12px);
      outline: none;
      transition: all 0.2s ease;
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
    }

    .search-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 4px var(--accent-glow);
    }

    .search-input::placeholder {
      color: var(--text-muted);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
      width: 100%;
      max-width: 1280px;
    }

    .category-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      padding: 1.25rem;
      backdrop-filter: blur(12px);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .category-title {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .bookmark-count {
      background: rgba(255, 255, 255, 0.05);
      padding: 0.2rem 0.5rem;
      border-radius: 6px;
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .bookmark-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      max-height: 480px;
      overflow-y: auto;
      padding-right: 0.25rem;
    }

    .bookmark-list::-webkit-scrollbar {
      width: 4px;
    }

    .bookmark-list::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.15);
      border-radius: 4px;
    }

    .bookmark-item a {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.6rem 0.75rem;
      border-radius: var(--radius-md);
      color: var(--text-main);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      transition: all 0.15s ease;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .bookmark-item a:hover {
      background: var(--card-hover-bg);
      color: #ffffff;
      transform: translateX(3px);
    }

    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--text-muted);
      grid-column: 1 / -1;
      background: var(--card-bg);
      border: 1px dashed var(--card-border);
      border-radius: var(--radius-lg);
      backdrop-filter: blur(12px);
    }

    .empty-state h2 {
      color: var(--text-main);
      font-size: 1.25rem;
      margin-bottom: 0.5rem;
    }

    @media (max-width: 640px) {
      body {
        padding: 1rem;
      }
      .time {
        font-size: 2rem;
      }
      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>

  <header>
    <div class="top-bar">
      <div class="clock-container">
        <div class="time" id="clock">00:00:00</div>
        <div class="date" id="date">Loading date...</div>
      </div>
      <div class="controls">
        <label for="file-input" class="btn">
          📁 Import Bookmarks (HTML)
        </label>
        <input type="file" id="file-input" accept=".html" />
        <button class="btn btn-danger" id="clear-btn">Clear Data</button>
      </div>
    </div>

    <div class="search-container">
      <input
        type="text"
        class="search-input"
        id="search-bar"
        placeholder="Filter bookmarks or press Enter to search Google..."
      />
    </div>
  </header>

  <main class="grid" id="bookmark-grid">
    <!-- Populated dynamically via JS -->
  </main>

  <script>
    // --- Clock Logic ---
    function updateClock() {
      const now = new Date();
      document.getElementById('clock').textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      document.getElementById('date').textContent = now.toLocaleDateString([], { weekday: 'long', month: 'short', day: 'numeric', year: 'numeric' });
    }
    setInterval(updateClock, 1000);
    updateClock();

    // --- State & App Logic ---
    let bookmarkData = {};

    function loadFromStorage() {
      const stored = localStorage.getItem('user_bookmarks_dashboard');
      if (stored) {
        try {
          bookmarkData = JSON.parse(stored);
          renderBookmarks();
        } catch (e) {
          console.error("Error reading stored bookmarks:", e);
        }
      } else {
        renderEmptyState();
      }
    }

    function saveToStorage() {
      localStorage.setItem('user_bookmarks_dashboard', JSON.stringify(bookmarkData));
    }

    function renderEmptyState() {
      const grid = document.getElementById('bookmark-grid');
      grid.innerHTML = `
        <div class="empty-state">
          <h2>No Bookmarks Loaded Yet</h2>
          <p>Click "Import Bookmarks (HTML)" at the top right to select your <code>bookmarks_10_31_26.html</code> file.</p>
        </div>
      `;
    }

    function renderBookmarks(filter = '') {
      const grid = document.getElementById('bookmark-grid');
      grid.innerHTML = '';

      const categories = Object.keys(bookmarkData);
      if (categories.length === 0) {
        renderEmptyState();
        return;
      }

      let totalMatches = 0;

      categories.forEach(catName => {
        const links = bookmarkData[catName].filter(item =>
          item.name.toLowerCase().includes(filter.toLowerCase()) ||
          item.url.toLowerCase().includes(filter.toLowerCase())
        );

        if (links.length > 0) {
          totalMatches += links.length;
          const card = document.createElement('section');
          card.className = 'category-card';

          const linksHTML = links.map(link => `
            <li class="bookmark-item">
              <a href="${link.url}" target="_blank" rel="noopener">
                ${link.name}
              </a>
            </li>
          `).join('');

          card.innerHTML = `
            <div class="category-title">
              <span>${catName}</span>
              <span class="bookmark-count">${links.length}</span>
            </div>
            <ul class="bookmark-list">
              ${linksHTML}
            </ul>
          `;

          grid.appendChild(card);
        }
      });

      if (totalMatches === 0 && filter !== '') {
        grid.innerHTML = `
          <div class="empty-state">
            <h2>No matching bookmarks found</h2>
            <p>Press Enter to search Google for "<strong>${filter}</strong>"</p>
          </div>
        `;
      }
    }

    // --- Netscape Bookmark HTML Parser ---
    function parseBookmarkHTML(htmlText) {
      const parser = new DOMParser();
      const doc = parser.parseFromString(htmlText, 'text/html');
      const parsedData = { GOOGLE: [], MEDIA: [], SOCIAL: [], TOOLS: [] };

      // Helper to traverse bookmark DL/H3 tree
      const headers = doc.querySelectorAll('h3');
      headers.forEach(h3 => {
        const title = h3.textContent.trim().toUpperCase();
        if (parsedData.hasOwnProperty(title)) {
          const parentDl = h3.nextElementSibling;
          if (parentDl && parentDl.tagName === 'DL') {
            const anchors = parentDl.querySelectorAll('a');
            anchors.forEach(a => {
              parsedData[title].push({
                name: a.textContent.trim(),
                url: a.getAttribute('href')
              });
            });
          }
        }
      });

      return parsedData;
    }

    // --- Event Listeners ---
    document.getElementById('file-input').addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (event) => {
        const content = event.target.result;
        bookmarkData = parseBookmarkHTML(content);
        saveToStorage();
        renderBookmarks();
      };
      reader.readAsText(file);
    });

    document.getElementById('clear-btn').addEventListener('click', () => {
      if (confirm("Are you sure you want to clear your stored bookmarks?")) {
        localStorage.removeItem('user_bookmarks_dashboard');
        bookmarkData = {};
        renderEmptyState();
      }
    });

    const searchBar = document.getElementById('search-bar');
    searchBar.addEventListener('input', (e) => {
      renderBookmarks(e.target.value);
    });

    searchBar.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && searchBar.value.trim() !== '') {
        window.open(`https://www.google.com/search?q=${encodeURIComponent(searchBar.value)}`, '_blank');
      }
    });

    // Initial Load
    loadFromStorage();
  </script>
</body>
</html>
